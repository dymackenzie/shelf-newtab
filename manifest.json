{
  "manifest_version": 3,
  "name": "Shelf",
  "short_name": "Shelf",
  "version": "1.0.0",
  "description": "A shelf of books on your new tab, separate from the bookmarks bar.",
  "key": "",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "history"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
